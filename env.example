# Portainer stack variables. Copy this file to .env and edit that private copy.
# Never put real credentials in this public example; .env is gitignored.

# Retry/refresh interval in seconds (1-99999), shared by backsoon and the panel.
BACKSOON_REFRESH=10

# Panel administrator (backsoon-admin). Without a user, a password or hash, and a session
# secret, the panel refuses to start; backsoon keeps serving pages either way.
BACKSOON_ADMIN_USER=admin

# Preferred: bcrypt hash of the password (see README, "Admin panel"). Generate it with (the
# leading space keeps the command, which contains the password, out of the shell history):
#    docker run --rm httpd:2.4-alpine htpasswd -nbBC 12 admin 'your-password' | cut -d: -f2
# or, with apache2-utils installed:
#    htpasswd -nbBC 12 admin 'your-password' | cut -d: -f2
# The result starts with $2y$12$ and is 60 characters long. Keep the single quotes here:
# without them Docker Compose reads every "$" in the hash as a variable and truncates it.
# In Portainer's environment variables, paste the hash as is; if the panel then refuses to start
# with "BACKSOON_ADMIN_PASSWORD_HASH is not a valid bcrypt hash", write every "$" as "$$".
# Leave the plaintext password empty when you use a hash; if both are set, the hash wins.
BACKSOON_ADMIN_PASSWORD_HASH=''

# Alternative: plaintext password (not recommended; the panel logs a warning at start).
BACKSOON_ADMIN_PASSWORD=

# Unique random secret of at least 32 bytes that signs sessions. Generate it with:
#   openssl rand -hex 32
# or, without openssl:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
# Changing it signs everyone out.
BACKSOON_SESSION_SECRET=

# Optional: host address and port the panel is published on (default 127.0.0.1 and 8181).
# 0.0.0.0 exposes it on every host address; sign-in still needs HTTPS (the cookie is Secure).
BACKSOON_ADMIN_HOST_BIND=
BACKSOON_ADMIN_HOST_PORT=

# Optional: host path of NPM's /data/nginx/custom directory. When set, every deploy installs
# server_proxy.conf there; NPM applies it at its next reload (save any proxy host or restart NPM).
# Example: /docker/nginx-proxy-manager/data/nginx/custom
BACKSOON_NPM_CUSTOM_DIR=
# false: leave application 503 responses alone (intercept only 502 and 504). Default true.
BACKSOON_NPM_INTERCEPT_503=

# Optional: the existing Docker network shared with Nginx Proxy Manager (default proxy).
BACKSOON_PROXY_NETWORK=

# Optional: IP addresses or CIDR ranges allowed to set X-Real-IP for the login rate limit.
# Use the proxy network range, from:
#   docker network inspect proxy --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# Empty: X-Real-IP is believed from any peer on that network.
BACKSOON_TRUSTED_PROXIES=
