# Portainer stack variables. Copy this file to .env and edit that private copy.
# Never put real credentials in this public example; .env is gitignored.

# Active in docker-compose.yml: retry/refresh interval in seconds (1-99999).
BACKSOON_REFRESH=10

# Planned admin panel (PRD section 7.5): NOT implemented or wired into compose yet.
# These values have no effect on the current static-only stack.
BACKSOON_ADMIN_USER=admin

# Preferred: bcrypt password hash. Leave plaintext empty when using a hash.
# If both are set, the planned panel will prefer the hash.
BACKSOON_ADMIN_PASSWORD_HASH=

# Alternative: plaintext password (not recommended). No default password is provided.
BACKSOON_ADMIN_PASSWORD=

# Required for the planned panel: unique random secret with at least 32 bytes.
# Generate locally, e.g. openssl rand -hex 32; do not reuse the example as a secret.
BACKSOON_SESSION_SECRET=
