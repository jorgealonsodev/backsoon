# Portainer stack variables. Copy this file to .env and edit that private copy.
# Never put real credentials in this public example; .env is gitignored.

# Retry/refresh interval in seconds (1-99999), shared by backsoon and the panel.
BACKSOON_REFRESH=10

# Panel administrator (backsoon-admin). Without a user, a password or hash, and a session
# secret, the panel refuses to start; backsoon keeps serving pages either way.
BACKSOON_ADMIN_USER=admin

# Preferred: bcrypt hash of the password (see README, "Admin panel"). Keep the single quotes:
# without them Docker Compose reads every "$" in the hash as a variable and truncates it.
# Leave the plaintext password empty when you use a hash; if both are set, the hash wins.
BACKSOON_ADMIN_PASSWORD_HASH=''

# Alternative: plaintext password (not recommended; the panel logs a warning at start).
BACKSOON_ADMIN_PASSWORD=

# Unique random secret of at least 32 bytes that signs sessions, e.g. openssl rand -hex 32.
# Changing it signs everyone out.
BACKSOON_SESSION_SECRET=

# Optional: IP addresses or CIDR ranges allowed to set X-Real-IP for the login rate limit.
# Use the proxy network range, from:
#   docker network inspect proxy --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
# Empty: X-Real-IP is believed from any peer on that network.
BACKSOON_TRUSTED_PROXIES=
